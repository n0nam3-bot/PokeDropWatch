rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The website never accesses Firestore directly. All subscriber reads and
    // writes go through the trusted Apps Script / GitHub Actions service account
    // using Google IAM. Server SDK/service-account requests are not authorized
    // by these client security rules. Deny every browser/client request.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
